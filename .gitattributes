# Repo stores LF; working tree per the rules below.
* text=auto

# Windows-native tooling: CRLF on disk
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Unix-consumed even on Windows: keep LF
*.sh    text eol=lf

# Never touch
*.exe   binary
*.png   binary
